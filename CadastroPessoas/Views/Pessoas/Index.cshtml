<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastro de Pessoas</title>
</head>
<body>
    <h1>Cadastro de Pessoas</h1>
    <a href="/Pessoas/Create" class="btn btn-primary" style="float: right;">+ Cadastro</a>
    <table class="table">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Telefone</th>
                <th>CPF</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pessoa in Model)
            {
                    <tr>
                        <td><a href="/Pessoas/Edit/@pessoa.Id">@pessoa.Nome</a></td>
                        <td>@pessoa.Telefone</td>
                        <td>@pessoa.Cpf</td>
                        <td>
                            <form method="post" action="/Pessoas/Delete/@pessoa.Id" onsubmit="return confirm('Deseja excluir esta pessoa?');">
                                <button type="submit" class="btn btn-danger">X</button>
                            </form>
                        </td>
                    </tr>
            }
        </tbody>
    </table>
</body>
</html>
